# Telegram creds for get_new_url() — copy to .env and fill in.
# api_id / api_hash: https://my.telegram.org -> API development tools
# TG_SESSION: run `python -m backend.scripts.tg_session` once, paste the output.
# TG_CHANNEL: @username (or numeric id) of the channel that posts the new domain.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_CHANNEL=

# Show the projection booth log in the frontends (true/false).
DEBUG=false
